#!/usr/bin/env bash
# MSO AppDeck lifecycle adapter for the Docker/server distribution of 9Router.
# Speaks the shared adapter contract (--version / check / install / update / uninstall).
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ARTIFACT_LOCK="$ROOT/security/managed-app-artifacts.env"
[ -r "$ARTIFACT_LOCK" ] || { echo "missing managed-app artifact lock: $ARTIFACT_LOCK" >&2; exit 2; }
# shellcheck source=security/managed-app-artifacts.env
. "$ARTIFACT_LOCK"

NAME="${NINE_ROUTER_CONTAINER:-9router}"
PORT="${NINE_ROUTER_PORT:-20128}"
IMAGE="${NINE_ROUTER_IMAGE:-$NINE_ROUTER_IMAGE_REF}"
case "$IMAGE" in
  *@sha256:????????????????????????????????????????????????????????????????) ;;
  *) echo "NINE_ROUTER_IMAGE must be an immutable @sha256 reference" >&2; exit 2 ;;
esac
EXPECTED_DIGEST="${IMAGE##*@}"
[[ "$EXPECTED_DIGEST" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "NINE_ROUTER_IMAGE digest must be lowercase sha256" >&2; exit 2; }
readonly NINE_ROUTER_IMAGE_REF IMAGE EXPECTED_DIGEST
EXPOSE_PUBLIC="${NINE_ROUTER_EXPOSE_PUBLIC:-0}"
case "$EXPOSE_PUBLIC" in
  0) BIND=127.0.0.1 ;;
  1) BIND=0.0.0.0 ;;
  *) echo "NINE_ROUTER_EXPOSE_PUBLIC must be 0 or 1" >&2; exit 2 ;;
esac
DATA="${NINE_ROUTER_DATA:-$HOME/.9router}"
PROXY_NETWORK="${NINE_ROUTER_PROXY_NETWORK:-dokploy-network}"
BASE="http://127.0.0.1:${PORT}"

DOCKER=(docker)
resolve_docker() {
  if docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
    DOCKER=(docker); return 0
  fi
  if sudo -n docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
    DOCKER=(sudo -n docker); return 0
  fi
  echo "docker daemon unavailable to the MSO service user" >&2
  return 1
}

installed() { "${DOCKER[@]}" ps -a --format '{{.Names}}' | grep -qx "$NAME"; }

image_has_expected_digest() {
  "${DOCKER[@]}" image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$1" 2>/dev/null \
    | grep -Eq "@${EXPECTED_DIGEST}$"
}

running_image_matches_lock() {
  installed || return 1
  local image_id
  image_id="$("${DOCKER[@]}" inspect --format '{{.Image}}' "$NAME" 2>/dev/null)" || return 1
  "${DOCKER[@]}" image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$image_id" 2>/dev/null \
    | grep -Eq "@${EXPECTED_DIGEST}$"
}

label_version() {
  "${DOCKER[@]}" inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' \
    "$("${DOCKER[@]}" inspect --format '{{.Image}}' "$NAME" 2>/dev/null)" 2>/dev/null || true
}

cmd_version() {
  resolve_docker
  installed || { echo "9router container not found" >&2; exit 1; }
  local v
  v="$(label_version)"
  [ -n "$v" ] && { echo "$v"; return; }
  curl -fsS -m 5 "$BASE/api/version" | sed -n 's/.*"currentVersion":"\([^"]*\)".*/\1/p'
}

cmd_check() {
  resolve_docker
  installed || { echo "9router container not found" >&2; exit 1; }
  local current latest has_update
  current="$("${DOCKER[@]}" inspect --format '{{.Image}}' "$NAME" 2>/dev/null | cut -c1-19)"
  latest="${EXPECTED_DIGEST:0:19}"
  if running_image_matches_lock; then has_update=false; else has_update=true; fi
  printf '{"currentVersion":"%s","latestVersion":"%s","hasUpdate":%s}\n' "$current" "$latest" "$has_update"
}

# Pull latest, recreate the container, keep the data mount.
cmd_update() {
  resolve_docker
  echo "[appdeck] step=download Pulling verified 9Router image"
  echo "==> pull $IMAGE"
  "${DOCKER[@]}" pull "$IMAGE"
  image_has_expected_digest "$IMAGE" || {
    echo "pulled 9Router image does not expose the locked digest $EXPECTED_DIGEST" >&2; exit 1
  }

  local owner
  owner="$("${DOCKER[@]}" ps -a --format '{{.Names}} {{.Ports}}' | grep ":${PORT}->" | awk '{print $1}' || true)"
  if [ -n "$owner" ] && [ "$owner" != "$NAME" ]; then
    echo "abort: port $PORT is held by container '$owner', not $NAME" >&2; exit 1
  fi

  mkdir -p "$DATA"
  local network_args=()
  if "${DOCKER[@]}" network inspect "$PROXY_NETWORK" >/dev/null 2>&1; then
    network_args=(--network "$PROXY_NETWORK")
  fi
  echo "[appdeck] step=apply Starting 9Router container on $BIND:$PORT"
  echo "==> recreate $NAME (bind $BIND:$PORT${network_args:+, network $PROXY_NETWORK})"
  "${DOCKER[@]}" rm -f "$NAME" 2>/dev/null || true
  "${DOCKER[@]}" run -d \
    --name "$NAME" \
    --restart unless-stopped \
    "${network_args[@]}" \
    -p "$BIND:$PORT:$PORT" \
    -v "$DATA:/app/data" \
    -e DATA_DIR=/app/data \
    "$IMAGE"

  echo "[appdeck] step=health Waiting for 9Router health check at $BASE/api/health"
  echo "==> wait for $BASE"
  local i running
  for i in $(seq 1 60); do
    sleep 1
    if curl -fsS -o /dev/null -m 3 "$BASE/api/health"; then
      running_image_matches_lock || { echo "running 9Router image does not match the locked digest" >&2; return 1; }
      echo "[appdeck] step=ready 9Router is healthy ($(label_version))"
      echo "==> healthy after ${i}s ($(label_version))"
      return 0
    fi
    running="$("${DOCKER[@]}" inspect --format '{{.State.Running}}' "$NAME" 2>/dev/null || true)"
    if [ "$running" != "true" ]; then
      echo "9Router container stopped unexpectedly during startup" >&2
      "${DOCKER[@]}" logs --tail 25 "$NAME" >&2 || true
      exit 1
    fi
  done
  echo "container is running but $BASE/api/health has not answered within 60s" >&2
  "${DOCKER[@]}" ps --filter "name=$NAME" --format '{{.Status}} {{.Ports}}' >&2
  "${DOCKER[@]}" logs --tail 25 "$NAME" >&2 || true
  exit 1
}

cmd_uninstall() {
  local dry=0
  case "${1:-}" in
    --dry-run) dry=1 ;;
  esac
  if [ "$dry" = 1 ]; then
    echo "would remove container: $NAME"
    echo "kept: image $IMAGE, data $DATA"
    exit 0
  fi
  resolve_docker
  installed || { echo "9router container not found - nothing to remove" >&2; exit 0; }
  echo "[appdeck] step=apply Removing 9Router container (keeping data in $DATA)"
  "${DOCKER[@]}" rm -f "$NAME"
  echo "[appdeck] step=ready Removed container $NAME"
  echo "removed container $NAME (kept image $IMAGE and data $DATA)"
}

case "${1:-}" in
--version) cmd_version ;;
check) cmd_check ;;
status)
  resolve_docker
  installed && "${DOCKER[@]}" ps --filter "name=$NAME" --format '{{.Status}} {{.Ports}}' || echo "not installed"
  ;;
install | update)
  [ "${2:-}" = "--yes" ] || [ "$1" = "install" ] || { echo "update requires --yes" >&2; exit 2; }
  cmd_update
  ;;
uninstall)
  shift
  case "${1:-}" in
  --help) echo "usage: managed-app-9router uninstall --yes [--dry-run]"; exit 0 ;;
  --yes) shift; cmd_uninstall "${1:-}" ;;
  *) echo "uninstall requires --yes" >&2; exit 2 ;;
  esac
  ;;
*)
  echo "usage: managed-app-9router --version|check [--json]|status|install|update --yes|uninstall --yes [--dry-run]" >&2
  exit 2
  ;;
esac
