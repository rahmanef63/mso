#!/usr/bin/env bash
# MSO local/public gateway dispatcher. Public access is always an outbound HTTPS
# tunnel; the Next application itself remains on a validated loopback origin.
set -euo pipefail
umask 077

ROOT="${MSO_GATEWAY_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ENVF="${MSO_GATEWAY_ENV:-$ROOT/.env.local}"
LOCAL_URL_OVERRIDE="${MSO_GATEWAY_LOCAL_URL:-}"
LOCAL_URL=""
STATE_ROOT="${MSO_GATEWAY_STATE_DIR:-$HOME/.mso/private/gateway}"
CLOUDFLARED=""
CURL="${MSO_GATEWAY_CURL:-$(command -v curl 2>/dev/null || true)}"

for dep in node jq sha256sum realpath stat mktemp; do command -v "$dep" >/dev/null || { echo "mso gateway: missing dependency: $dep" >&2; exit 1; }; done
[ -n "$CURL" ] || { echo "mso gateway: curl is required" >&2; exit 1; }

# shellcheck source=scripts/lib/private-state.sh
. "$ROOT/scripts/lib/private-state.sh"
# shellcheck source=scripts/lib/gateway-common.sh
. "$ROOT/scripts/lib/gateway-common.sh"
# Source config early because it owns the single env-file safety validator.
# shellcheck source=scripts/lib/gateway-config.sh
. "$ROOT/scripts/lib/gateway-config.sh"

# Direct `scripts/mso-gateway` calls and `mso gateway` must have the same runtime
# environment. The file is owner/private checked before sourcing. cloudflared is
# spawned later with a scrubbed environment so these secrets never reach it.
if [ "$ENVF" != /dev/null ] && { [ -e "$ENVF" ] || [ -L "$ENVF" ]; }; then
  gateway_safe_env_file
  # shellcheck disable=SC1090
  set -a; . "$ENVF"; set +a
fi
LOCAL_URL="${LOCAL_URL_OVERRIDE:-${MSO_GATEWAY_LOCAL_URL:-http://127.0.0.1:${MSO_PORT:-4005}}}"
LOCAL_URL="$(gateway_validate_loopback_origin "$LOCAL_URL" 2>/dev/null || true)"
[ -n "$LOCAL_URL" ] || gateway_fail "refusing non-loopback/invalid upstream; use a clean http://127/8, localhost, or ::1 origin with an explicit port"
STATE_ROOT="$(mso_private_state_dir "$STATE_ROOT")" || gateway_fail "unsafe gateway state directory"
STATE_FILE="$STATE_ROOT/state.json"
CF_LOG="$STATE_ROOT/cloudflared.log"
RUNTIME_LOG="$STATE_ROOT/runtime.log"
LOCK_DIR="$STATE_ROOT/lifecycle.lock"
LOCK_HELD=0

# shellcheck source=scripts/lib/gateway-network.sh
. "$ROOT/scripts/lib/gateway-network.sh"
# shellcheck source=scripts/lib/gateway-tool.sh
. "$ROOT/scripts/lib/gateway-tool.sh"
# shellcheck source=scripts/lib/gateway-lock.sh
. "$ROOT/scripts/lib/gateway-lock.sh"
# shellcheck source=scripts/lib/gateway-recovery.sh
. "$ROOT/scripts/lib/gateway-recovery.sh"
# shellcheck source=scripts/lib/gateway-runtime.sh
. "$ROOT/scripts/lib/gateway-runtime.sh"
# shellcheck source=scripts/lib/gateway-tunnel.sh
. "$ROOT/scripts/lib/gateway-tunnel.sh"
case "${1:-status}" in
  start) gateway_parse_start_args "$@"; gateway_with_lock gateway_cmd_start_locked ;;
  stop) gateway_with_lock gateway_cmd_stop_locked ;;
  status) gateway_cmd_status ;;
  url) gateway_cmd_url ;;
  doctor) gateway_cmd_doctor ;;
  install) gateway_cmd_install_tool ;;
  domain) shift; gateway_cmd_domain "$@" ;;
  web) gateway_cmd_web "$@" ;;
  local-start) gateway_with_lock gateway_cmd_local_start_locked ;; # internal: onboard/web/update fallback
  runtime-stop) gateway_with_lock gateway_cmd_runtime_stop_locked ;; # internal: quiesce owned runtime before offline build
  *) gateway_fail "usage: mso gateway start|stop|status|url|doctor|install|domain ..." ;;
esac
