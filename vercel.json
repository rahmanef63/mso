{
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node demo/build.mjs",
  "outputDirectory": "demo/out",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "connect-src 'self'; frame-src 'self' blob:; object-src 'none'; form-action 'none'; base-uri 'self'; frame-ancestors https://manef.dev https://www.manef.dev",
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "/(?:demo|mso/demo)/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/install/?",
      "status": 308,
      "headers": {
        "Location": "https://manef.dev/mso/install"
      }
    },
    {
      "src": "/docs/(.+)",
      "status": 308,
      "headers": {
        "Location": "https://manef.dev/mso/docs/$1"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api(?:/|$)|mcp(?:/|$)|oauth(?:/|$)|_next(?:/|$)|\\.well-known(?:/|$)).+)",
      "dest": "/index.html"
    }
  ]
}
