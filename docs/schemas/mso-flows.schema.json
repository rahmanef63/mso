{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSO project automation manifest v1",
  "description": "Structural schema. Runtime also enforces byte limits, secret-field rejection, unique ids, backward-only references, safe defaults, project and authority constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "flows"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "flows": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/flow"
      }
    }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "inputs",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "inputs": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "enum": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "tool": {
          "enum": [
            "integration_execute",
            "project_mcp_call",
            "project_function_call"
          ]
        },
        "arguments": {
          "type": "object"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "equals"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "equals": {}
          }
        }
      }
    }
  }
}
