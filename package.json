{
  "name": "mso",
  "version": "0.2.23",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "bun": ">=1.4.2 <2"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "bash scripts/build-safe.sh",
    "start": "node scripts/server.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-test-toolchain.mjs && vitest run",
    "coverage": "node scripts/check-test-toolchain.mjs && vitest run --coverage",
    "check": "node scripts/check-cycles.mjs && node scripts/check-architecture.mjs && node scripts/check-docs.mjs && node scripts/gen-comparison.mjs --check && node scripts/check-contrast.mjs && bun scripts/check-skill-flows.mjs && bun run check:instance-literals && bun run test:ci && bun run parity:nakama && bun run test:parity",
    "audit": "node scripts/audit.mjs",
    "verify": "bun run typecheck && bun run lint && bun run coverage && bun run check && bun run audit",
    "pr:preflight": "bash scripts/pr-preflight.sh --full",
    "pr:local": "bash scripts/pr-preflight.sh --local",
    "pr:security": "bash scripts/pr-preflight.sh --security",
    "security:ultimate": "bash scripts/security-ultimate.sh",
    "e2e": "node scripts/e2e/shell.mjs",
    "e2e:preview": "node scripts/e2e/preview.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "ship": "bash scripts/ship.sh",
    "smoke": "vitest run --config scripts/e2e/vitest.config.mts",
    "icons:app": "node scripts/gen-app-icons.mjs && python3 scripts/gen-remaining-platform-icons.py",
    "skill:new": "node scripts/create-skill-flow.mjs",
    "skill:check": "bun scripts/check-skill-flows.mjs",
    "plugin:link-app": "node scripts/link-openai-app.mjs",
    "plugin:stage-private": "node scripts/stage-openai-plugin.mjs",
    "plugin:doctor-private": "node scripts/openai-plugin-doctor.mjs",
    "comparison": "node scripts/gen-comparison.mjs",
    "bench:cognitive": "bun scripts/bench-cognitive-runtime.mjs",
    "bench:memory": "bun scripts/bench-memory-retrieval.mjs",
    "bench:memory:calibration": "bun scripts/bench-memory-calibration.mjs",
    "bench:memory:lifecycle": "bun scripts/bench-memory-lifecycle.mjs",
    "bench:memory:retrieval-calibration": "bun scripts/bench-memory-retrieval-calibration.mjs",
    "bench:quality": "bun scripts/bench-task-quality.mjs",
    "bench:agents": "bun scripts/bench-agent-comparison.mjs",
    "forge:sandbox": "bash scripts/provision-forge-sandbox.sh",
    "bench:pipeline": "bun scripts/bench-read-pipeline.mjs",
    "bench:corpus": "bun scripts/bench-agent-corpus.mjs",
    "bench:corpus:repeat": "bun scripts/bench-agent-repeat.mjs",
    "bench:cache-calibration": "bun scripts/bench-agent-cache.mjs",
    "mcp:catalog": "node scripts/gen-mcp-catalog.mjs",
    "audit:strict": "node scripts/audit.mjs --strict",
    "test:features": "node scripts/test-features.mjs",
    "screenshot:cli": "node scripts/capture-cli.mjs",
    "check:instance-literals": "bun scripts/check-instance-literals.mjs",
    "e2e:release": "node scripts/e2e/release.mjs",
    "bundle:report": "node scripts/check-bundle.mjs --report-only",
    "bundle:check": "node scripts/check-bundle.mjs",
    "perf:probe": "node scripts/perf-probe.mjs",
    "perf:check": "node scripts/check-perf.mjs",
    "perf:hydration": "node scripts/perf-hydration.mjs",
    "perf:apps": "node scripts/perf-app-open.mjs",
    "perf:tasks": "node scripts/perf-longtasks.mjs",
    "ci:plan": "node scripts/ci/run.mjs --plan",
    "ci:verify": "node scripts/ci/run.mjs --profile verify",
    "ci:security": "node scripts/ci/run.mjs --profile security",
    "ci:release": "node scripts/ci/run.mjs --profile release",
    "test:ci": "node --test scripts/ci/contract.node.mjs",
    "parity:nakama": "node scripts/check-nakama-parity.mjs && node scripts/gen-nakama-parity.mjs --check",
    "parity:nakama:release": "node scripts/check-nakama-parity.mjs --release",
    "test:parity": "node --test scripts/parity/inventory.node.mjs",
    "mcp:orca": "node bin/orca-mcp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@imgly/background-removal": "^1.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "konva": "^10.9.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-resizable-panels": "^4.14.6",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "overrides": {
    "postcss": "^8.5.10",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "micromatch": "npm:picomatch@2.3.2",
    "zod": "^4.6.6",
    "minimatch": "^11.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.2",
    "fast-check": "^4.10.2",
    "parse5": "8.0.1",
    "postcss": "^8.5.29",
    "simple-icons": "^16.34.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "8.2.4",
    "vitest": "5.0.5",
    "brace-expansion": "5.0.12"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "brace-expansion@5.0.12": "patches/brace-expansion@5.0.12.patch",
    "fast-glob@3.3.1": "patches/fast-glob@3.3.1.patch",
    "node-pty@1.1.0": "patches/node-pty@1.1.0.patch"
  }
}
