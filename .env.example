# mso — environment. Copy to .env.local (gitignored) and fill in.
# mso is self-contained: a Next.js app that runs AS a host process and
# controls the machine it runs on. No database, no external backend.

# --- Auth (required) ---
# Owner-first deployment login. Min 6 chars; use a strong password for any exposed host.
# Each approved browser is assigned Viewer, Operator, or Owner. Roles are device-scoped
# application controls over one Unix service account—not named-user SSO or Linux users.
# Device approval is a browser allowlist, not standards-based MFA.
OS_LOGIN_PASSWORD=change-me
# HMAC key that signs the session cookie. MUST be strong — generate with:
#   openssl rand -hex 32
OS_SESSION_SECRET=
# Session lifetime in hours (default 24). Keep it short — a live session can run
# shell commands. Raise only behind a trusted network.
# SESSION_EXPIRY_HOURS=24
# The session cookie is host-only by default. Widening it (OS_SESSION_COOKIE_DOMAIN)
# is ONLY for split-origin managed apps — see that section below; do not set one
# without the other.

# --- Filesystem bounds (optional) ---
# Colon-separated roots. "~" = home, "/" = whole filesystem.
# READ defaults to home + ~/projects; set "/" to browse the whole box read-only.
# OS_FS_READ_ROOTS=/
# WRITE defaults to home + ~/projects (narrow, so the OS can't clobber system files).
# OS_FS_WRITE_ROOTS=~:~/projects
# Sensitive home files (~/.ssh, ~/.aws, shell history, shell rc/profile files —
# where `export …_TOKEN=` lines live — …) are blocked even within
# the read roots. Set =1 to lift that denylist (you accept the exposure).
# OS_FS_ALLOW_SENSITIVE=1

# --- Exec safety + audit (optional) ---
# Catastrophic shell commands (rm -rf /, mkfs, dd to a block device, fork bomb…)
# are refused by default. Set =1 to allow them (do real disk surgery over SSH).
# OS_EXEC_ALLOW_DESTRUCTIVE=1
# Append-only audit trail of exec/file/browser/auth actions. Default path below.
# OS_AUDIT_LOG=~/.mso/audit.log
# Transcript of the last Settings → About "Software update" run — the panel polls
# this file, and scripts/self-update.sh truncates it on every start. Rarely worth
# moving; it is here because the updater runs as a transient systemd unit and the
# path is passed to it explicitly rather than inherited.
# MSO_UPDATE_LOG=~/.mso/self-update.log
# Number of trusted reverse-proxy hops in front of the app. The login rate
# limiter keys on the (N-from-last) x-forwarded-for hop, so a wrong value
# collapses every client into one bucket (too small N) or trusts spoofed
# client headers (too large N).
# 1 = direct proxy (default). 2 = Cloudflare → nginx → app, etc.
# OS_TRUSTED_PROXY_HOPS=1


# --- System Monitor Service Center (optional) ---
# Inventory for system/user *.service units is read-only by default. Logs require
# Operator/Owner. Lifecycle requires BOTH Operator/Owner and an exact comma/space
# separated scope:unit entry below. Wildcards, paths, flags and non-service units
# are ignored/rejected. Example:
# OS_SERVICE_CONTROL_UNITS=user:mso.service,system:nginx.service
# System units use the process user's existing permission. Set =1 only when you have
# deliberately granted narrowly-scoped non-interactive sudo for the exact units/actions.
# Never pair this with broad NOPASSWD systemctl/root access.
# OS_SERVICE_CONTROL_USE_SUDO=0
# Advanced binary overrides; normally leave unset. Useful only on unusual layouts/tests.
# MSO_SYSTEMCTL_BIN=/usr/bin/systemctl
# MSO_JOURNALCTL_BIN=/usr/bin/journalctl
# MSO_SUDO_BIN=/usr/bin/sudo
#
# Package Updates reads the EXISTING local cache only; it never refreshes or applies.
# Auto-detected managers: apt, dnf, yum, pacman, zypper. Optional detection/binary overrides:
# MSO_PACKAGE_MANAGER=apt
# MSO_APT_BIN=/usr/bin/apt
# MSO_DNF_BIN=/usr/bin/dnf
# MSO_YUM_BIN=/usr/bin/yum
# MSO_PACMAN_BIN=/usr/bin/pacman
# MSO_ZYPPER_BIN=/usr/bin/zypper

# --- Stock photo search (optional) ---
# The image picker's Stock tab searches the keyless Openverse API by default.
# Set an Unsplash Access Key (https://unsplash.com/developers) to search
# Unsplash instead (better quality). The key stays server-side.
# OS_UNSPLASH_ACCESS_KEY=

# --- AI assistant "Alfa" (optional, BYOK) ---
# Bring your own Anthropic key. Can also be set in the OS via Settings → AI
# (stored in ~/.mso/config.json). If unset, the assistant returns 501.
# ANTHROPIC_API_KEY=
# Official OpenAI API key. It may instead be saved through Settings → AI under
# provider OpenAI; the 0600 host credential store wins over this env fallback.
# OPENAI_API_KEY=
# Custom provider base URLs require HTTPS and public DNS/IP destinations. Set this
# only for an explicitly trusted loopback/LAN development endpoint; production
# requests still apply destination validation and redirect controls.
# OS_CUSTOM_PROVIDER_ALLOW_INSECURE_HTTP=0
#
# Provider-run tools the Codex backend may use, comma/space separated. EMPTY by
# default — no provider built-in is declared unless you name one here. Allowed:
# web_search, web_search_preview, file_search, code_interpreter,
# computer_use_preview, local_shell. `image_generation` is NOT allowed: MSO has no
# image generation on any surface, and a GPT client already carries its own.
# Provider-run usage may bill the connected ChatGPT account.
# OS_CODEX_BUILTIN_TOOLS=

# --- Managed apps: Hermes / OpenClaw (optional) ---
# MSO detects these two known apps through bounded service/package probes and can
# install/control/log/update/back up/restore them. It does NOT scrape vendor SPA routes
# into MSO features. The URLs below are only the known loopback dashboards used by the
# optional split-origin proxy.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119
# OPENCLAW_DASHBOARD_URL=http://127.0.0.1:18789
# NINE_ROUTER_DASHBOARD_URL=http://127.0.0.1:20128
# Existing browser-facing 9Router URL, if the deployment already owns one. This is
# preferred for the in-shell UI; do not create a new subdomain just because MSO can.
# Without it, MSO may use its split-origin host. There is no public-IP fallback
# unless the operator explicitly enables the Docker bind below.
# NINE_ROUTER_PUBLIC_URL=https://9-router.example.com
# Default 0: publish 127.0.0.1:20128 only. Set 1 only with a deliberate firewall/auth
# decision; this exposes 9Router's credential-bearing dashboard on every interface.
# NINE_ROUTER_EXPOSE_PUBLIC=0
# Hermes install home. Default ~/.hermes. Absolute, or "~/…" for the home of the
# user running mso. This is the tree the managed-app backup action copies.
# HERMES_HOME=/home/you/.hermes

# Public origin the BROWSER uses, e.g. https://mso.example.com. Only the scheme
# + host + port are read. The managed-app proxy scopes its Content-Security-Policy
# to this origin; without it the origin is inferred from the Host header and then
# from X-Forwarded-Host, and the latter is client-settable — set this whenever the
# app sits behind a reverse proxy so the policy can't be steered by a request.
# In split-origin mode (below) this is also the origin the app hosts name in
# `frame-ancestors`, so it decides whether the cockpit may frame the dashboard at
# all. Unset, it falls back to the parent name of the host template
# (`{id}.mso.example.com` → `https://mso.example.com`); if THAT yields nothing
# usable the policy emits `frame-ancestors 'none'` and the window stays blank —
# closed, on purpose, rather than naming a guessed origin as a permitted framer.
# OS_PUBLIC_ORIGIN=https://mso.example.com
# The CLI can set/clear the stable value safely with:
#   mso gateway domain set https://mso.example.com
#   mso gateway domain clear
# Temporary `mso gateway start` Quick Tunnels deliberately do NOT write this value.
# Optional CLI-only gateway controls (normally leave unset):
# MSO_GATEWAY_LOCAL_URL=http://127.0.0.1:4005
# MSO_GATEWAY_NO_AUTO_INSTALL=1  # require a pre-provisioned/reviewed cloudflared binary
# MSO_GATEWAY_PUBLIC_READY_SECONDS=60  # bounded HTTPS edge propagation wait (10..120)

# --- Embedded managed-app dashboards: optional split-origin decision ---
# Unset (default) = MSO does not EMBED vendor web UIs. Managed-app lifecycle and
# Details still work without a domain. 9Router remains loopback-only unless
# NINE_ROUTER_EXPOSE_PUBLIC=1 is explicitly set; public-IP access is never inferred.
#
# There is no fallback to serving them under a path on the cockpit's origin. That
# mode existed and was removed: those SPAs need allow-same-origin to run at all,
# so upstream JS reached `window.top` and called /api/v1/exec with your session —
# and `window.open('/')` did the same from a plain tab. No CSP can stop either (a
# policy binds a realm, not a reference across realms). Only a separate origin can.
#
# Set BOTH of the following to serve each dashboard from its OWN host — same
# process, cross-origin — so `window.top` is opaque:
#
#   1. NEXT_PUBLIC_MANAGED_APP_HOST_TEMPLATE — `{id}` is the app id, so this
#      yields hermes.mso.example.com, openclaw.mso.example.com, 9router.mso.example.com,
#      and the reserved camoufox.mso.example.com viewer origin. Provision ONLY the
#      explicit hosts you use; each needs its
#      own DNS record + TLS pointing at this app. On such a host the
#      middleware rewrites EVERY path into that app's proxy and 404s the rest, so
#      the cockpit API does not exist there.
#   2. OS_SESSION_COOKIE_DOMAIN — the session cookie is host-only by default and
#      would NOT be sent to those hosts, so the framed dashboard 401s on every
#      request. This adds `Domain=`, which sends it to the domain AND every
#      subdomain of it.
#
# THE CONSEQUENCE OF SETTING (2) WITHOUT (1): the session cookie is handed to
# every host under that domain, and each one still serves the whole cockpit —
# /api/v1/exec/run included. Anything that can answer on a *.mso.example.com name
# (a future subdomain, a stale DNS record someone else points here, a wildcard
# certificate reused by another service) receives the credential. Only the
# middleware host gating makes the widened cookie safe. Set both, or neither.
#
# Malformed values fail closed to host-only rather than emitting a broken header:
# the domain must be ≥2 DNS labels, not an IP, and must domain-match the request
# host, otherwise the browser drops the whole cookie and login 200s with no
# session. Note also that logout can only clear cookies it knows about — after
# UNSETTING the domain, an already-issued domain cookie can no longer be cleared
# by logout; revoke the device (Settings → Devices) to kill those sessions, or
# wait out SESSION_EXPIRY_HOURS.
#
# NEXT_PUBLIC_ is baked into the CLIENT bundle at BUILD time (the server and the
# middleware read it at runtime), so set it BEFORE `bun run build` — not just before
# the restart. Built without it, the browser still points the iframe at the old
# same-origin proxy URL while the server has already stopped answering there, and
# the app window comes up blank.
#
# AND THEN SIGN OUT AND BACK IN. The Domain is attached to the cookie when it is
# ISSUED and never afterwards — there is no sliding refresh — so every session that
# existed before you set this stays host-only and is never sent to the app hosts.
# The cockpit keeps working perfectly and only the dashboards 401, which reads as
# "the app host is broken" and is not. Nothing server-side can detect it either: a
# Cookie header carries no Domain, so a cookie that was never sent looks exactly
# like one that never existed. Turning this on is a three-step change — set, build,
# re-login — and skipping the third is the one that wastes an afternoon.
# NEXT_PUBLIC_MANAGED_APP_HOST_TEMPLATE={id}.mso.example.com
# OS_SESSION_COOKIE_DOMAIN=mso.example.com

# --- Storage paths (optional overrides) ---
# OS_DEVICE_STORE=~/.mso/auth-devices.json   # approved devices + live roles
# OS_CONFIG_STORE=~/.mso/config.json         # BYOK key + model
# OS_PREFS_PATH=~/.mso/prefs.json            # synced UI prefs (theme, layout)
# OS_MEMORY_STORE=~/.mso/memory.json         # Alfa assistant long-term memory
# OS_THREADS_DIR=~/.mso/threads              # Alfa assistant chat threads (one file each)
# OS_AGENT_MEMORY_DIR=~/.mso/agent-memory    # isolated MSO Agent USER.md/MEMORY.md stores
# OS_AGENT_SESSIONS_DIR=~/.mso/agent-sessions # durable CLI/MCP agent session records
# Session context is estimated provider-neutrally and compacted when it reaches this
# threshold. Raw/older context is first written as a SANITIZED gzip backup; secrets
# are recursively redacted before archival. Defaults: 700k threshold, 140k recent.
# OS_AGENT_SESSION_COMPACT_TOKENS=700000
# OS_AGENT_SESSION_RECENT_TOKENS=140000
# OS_AGENT_SESSION_ARCHIVE_DIR=~/.mso/agent-session-archive
# OS_AGENT_SESSION_ARCHIVE_DAYS=30
# Owner-private Dokploy/Cloudflare/Hostinger connection state. Defaults to the path
# below; normally leave it there so the 0700 directory + 0600 file policy applies.
# OS_INFRA_STORE=~/.mso/private/infra-providers.json
# CLI-only override for `mso skills install`; default ~/.mso/skills. The target is
# the explicit operator-trust root, so point this only at a private directory you own.
# MSO_SKILL_INSTALL_ROOT=~/.mso/skills

# --- Camoufox browser (the Browser app) ---
# The reserved split-origin camoufox host is mapped by proxy.ts to this noVNC/websockify
# endpoint only after a live Operator/Owner role check. The retired same-origin
# /camoufox-vnc/* path always 404s. This endpoint MUST stay loopback: a value pointing
# off-box would turn the viewer proxy into a relay, and proxy.ts rejects it.
# CAMOUFOX_NOVNC_URL=http://127.0.0.1:6080
#
# Plaintext copy of the VNC password, written beside x11vnc's own passwd blob (which is
# not meant to be read back) by scripts/camoufox-vnc-service. 0600, never committed.
# The API hands it to the viewer in the URL FRAGMENT, never the query string.
# CAMOUFOX_VNC_PASSWD_TEXT=~/.vnc/passwd.txt

# --- Build metadata (optional) ---
# Shown in Settings → About, and compared against the checkout's HEAD by the
# Software-update panel to tell "a build is pending" from "up to date". Set at BUILD
# time (NEXT_PUBLIC_ is inlined into the client bundle). You do NOT normally set it:
# next.config.mjs fills it from `git rev-parse --short HEAD` when it is unset. Set it
# only where the build has no .git (a tarball, a container build stage).
# NEXT_PUBLIC_COMMIT_SHA=
#
# The ONLY way to emit a ?dpl= query on static chunk URLs. Leave UNSET unless you are
# running skew protection: next.config.mjs used to fall back to Date.now() here, and
# because the config is evaluated twice (build, then `next start` boot) that produced
# two different values for the same chunk and every cold load downloaded ~160 KB gzip
# of entry chunks TWICE. Chunks are content-hashed, so unset is correct.
# NEXT_DEPLOYMENT_ID=

# --- Public demo build (optional, BUILD-TIME flag) ---
# Build with =1 for a safe public showcase: no login, no host access, no /api
# calls — forced mock data only. Use a separate checkout/service for the demo.
# NEXT_PUBLIC_OS_DEMO=1

# --- Forward-looking: Server Actions encryption (optional) ---
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY — UNUSED today (no Server Actions in repo).
# When the first Server Action lands, set this to a 32-byte hex random
# (openssl rand -hex 32) and keep it stable across deploys, else in-flight
# action payloads silently invalidate on rolling restart.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── MCP server (control this VPS from ChatGPT / Claude.ai / Cursor) ──────────
# OFF by default. While unset, /mcp and the OAuth discovery documents return 404 —
# there is no MCP surface at all, not an unauthenticated one.
# OS_MCP_ENABLED=1
# Highest tier the consent screen may grant. read | write | exec. Default: exec,
# and the consent screen preselects that highest allowed tier. Set read or write to
# opt down. `exec` means a leaked bearer runs any command on this box as you.
# OS_MCP_MAX_SCOPE=exec
# Where clients/codes/tokens live. Default ~/.mso/mcp.json (0600). Only sha256 of
# each code and token is ever written.
# OS_MCP_STORE=/home/you/.mso/mcp.json
# Persistent semantic skill/recipe memory. The default is ~/.mso/skill-memory.json
# (0600). Embeddings are deterministic and local — no API key, model download or
# network call is required.
# OS_SKILL_MEMORY_STORE=/home/you/.mso/skill-memory.json
# Optional live MCP activity log shown in Assistant → MCP. Default
# ~/.mso/mcp-activity.log. This is separate from the forensic audit trail and
# records tool lifecycle (started/completed/failed), including bounded reads.
# OS_MCP_ACTIVITY_LOG=/home/you/.mso/mcp-activity.log
# Internal loopback origin used by the read-only `screen_capture` MCP tool. The
# implementation refuses non-loopback values. Default http://127.0.0.1:4005.
# OS_SCREENSHOT_ORIGIN=http://127.0.0.1:4005

# Optional exact machine-to-machine ingress for PROJECT integrations on a managed
# app host. Stock MSO leaves this unset and exposes no such lane. JSON array, max
# 8 entries; POST only; target MUST be loopback; auth currently hmac-v2-json.
# MSO only prefilters HMAC-shaped headers — the loopback app verifies the secret.
# OS_PROJECT_INGRESS_ROUTES=[{"app":"hermes","method":"POST","path":"/webhooks/project-example","target":"http://127.0.0.1:8644/webhooks/project-example","auth":"hmac-v2-json","maxBodyBytes":262144}]
