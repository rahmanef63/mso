+//@ts-check
+const { spawnSync } = require('child_process');
+const fs = require('fs');
+const path = require('path');
+
+function findNodeGyp() {
+  // 1. Direct command if available in PATH
+  const check = spawnSync('node-gyp', ['--version'], { encoding: 'utf8' });
+  if (check.status === 0) return { cmd: 'node-gyp', args: [] };
+
+  // 2. Locate from npm
+  try {
+    const whichCmd = process.platform === 'win32' ? 'where' : 'which';
+    const npmBin = spawnSync(whichCmd, ['npm'], { encoding: 'utf8' }).stdout.trim().split('\n')[0].trim();
+    if (npmBin) {
+      const realNpm = fs.realpathSync(npmBin);
+      const npmDir = path.dirname(realNpm);
+      
+      // Check node-gyp-bin
+      const binGyp = path.join(npmDir, 'node-gyp-bin', process.platform === 'win32' ? 'node-gyp.cmd' : 'node-gyp');
+      if (fs.existsSync(binGyp)) {
+        return { cmd: binGyp, args: [] };
+      }
+
+      // Check bundled node-gyp.js
+      const jsGyp = path.join(npmDir, '../node_modules/node-gyp/bin/node-gyp.js');
+      if (fs.existsSync(jsGyp)) {
+        return { cmd: process.execPath, args: [jsGyp] };
+      }
+    }
+  } catch (err) {}
+
+  return null;
+}
+
+const gyp = findNodeGyp();
+if (!gyp) {
+  console.error('\x1b[31m> node-pty: node-gyp not found in PATH or via npm\x1b[0m');
+  process.exit(127);
+}
+
+const result = spawnSync(gyp.cmd, [...gyp.args, 'rebuild'], {
+  stdio: 'inherit',
+  cwd: path.join(__dirname, '..')
+});
+
+process.exit(result.status ?? 1);
