{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "next/server": [
        "./lib/http/next-server-shim.ts"
      ],
      "next/headers": [
        "./lib/http/next-headers-shim.ts"
      ],
      "server-only": [
        "./lib/http/server-only-shim.ts"
      ],
      "next/dist/shared/lib/router/utils/relativize-url": [
        "./lib/http/next-server-shim.ts"
      ],
      "@/*": [
        "./*"
      ],
      "@/shared/*": [
        "./lib/shared/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**",
    ".worktrees/**",
    "**/.worktrees/**",
    ".claude/worktrees/**",
    "**/zz-*",
    "frontend/svelte/**"
  ]
}
