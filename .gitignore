node_modules/
.next/
out/
build/
.env
.env.local
.env*.local
# `.env*.local` stops at the `.local`, so a hand-made `.env.local.bak` — or the dated
# copy any sane person takes before editing secrets — lands in `git status` as untracked
# and is one `git add -A` away from being published. The file it copies is ignored; the
# copy has the same contents and none of the protection.
.env.local.*
*.tsbuildinfo
next-env.d.ts
.DS_Store
.vercel
# os-browser: the sidecar's source was deleted 2026-08-10. Only the vendored
# Playwright install survives (scripts/gen-readme-media.mjs imports it), so track
# just the manifests that reproduce it.
os-browser/*
!os-browser/package.json
!os-browser/package-lock.json
convex-backend/
.mso/
# RASMIC repo-local orchestration memory/evidence is runtime state. It must survive
# locally but must not make the MSO source checkout dirty and block `mso update`.
.agent/
# local session progress log (not tracked)
progress.md

# Coverage output (pnpm coverage) — generated, never committed.
coverage/

# Agent/debug scratch harnesses — never committed, never run in CI.
**/zz-*

# Camoufox browser-profile data: live session cookies, saved logins and the key that
# decrypts them. It lives at ~/.local/share/camoufox/profiles/ and must never be inside a
# checkout — this is the backstop for a stray copy, or a CAMOUFOX_PROFILE aimed here.
camoufox-profile*/
**/cookies.sqlite*
**/key4.db
**/logins.json

# Python icon-generator bytecode.
__pycache__/
*.py[cod]
