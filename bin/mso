#!/usr/bin/env bash
# Manef Shell OS — drive the whole cockpit from the shell.
#
# Usage: mso [options] <command> [args]
#
# mso.rahmanef.com is only ONE frontend. Everything it can do is a call to the
# same /api surface, so this CLI reaches every feature without a browser.
# Auth = signed session cookie (password + approved device role), cached in a jar.
#
# Options:
#   --base <url>         API base to talk to (default http://127.0.0.1:4005)
#   --env <file>         Env file to source for secrets (default <repo>/.env.local)
#   -h, --help           Show this help, or `mso <command> --help` for one command
#   -v, --version        Show version
#
# Commands:
#   Hint: commands suffixed with * have subcommands. Run `mso <command> --help`.
#
#  Files
#   ls [path]            List a directory (default ~)
#   cat <path>           Read a text file
#   raw <path>           Stream a file's raw bytes to stdout (images, video, any blob)
#   share <id>           Download an authenticated temporary-link artifact to stdout
#   write <path> <text>  Write a file
#   mkdir <path>         Create a directory
#   rm <path>            Delete, recursively
#   mv <from> <to>       Move or rename
#   cp <from> <to>       Copy
#   zip <base> <name…>   Zip entries of <base> to stdout (redirect it to a .zip)
#   upload <local> <dst> Upload a local file into <dst> (the dir must already exist)
#   search <q> [root]    Find DIRECTORIES whose name matches (not contents; use exec+grep)
#   usage [path]         Disk usage
#
#  Host
#   exec <cmd…>          Run a shell command on the host (full power)
#   stats                CPU, memory, disk
#   ps                   Process table
#   units [query]        systemd service inventory (system + user)
#   unit *               logs | start | stop | restart for exact allowlisted units
#   packages             Cached package-update visibility (never applies updates)
#   cleanup [--run]      Reclaimable junk; --run actually deletes it
#   status               Public service status (no session needed)
#   health               Is this CLI's session valid?
#   doctor [--fix]       Check deps, HTTPS/login origin, service, session, device; --fix repairs safe local issues
#   agent [--continue|--resume <query>|--yolo|-yolo]  Interactive MSO Agent; --oneshot <prompt> for autonomous non-TTY runs
#   chat                 Alias for agent
#   model [ref]          Select active model from a connected provider
#   onboard [-y]         Guided setup: AI, apps, infrastructure, skills
#   setup                Alias for onboard
#   integrations  Named credential users, connections, sources, setup and execution
#   provider *           Infrastructure credentials: list | set | rm | doctor
#   providers *          Alias for provider
#   gateway *             Secure public HTTPS tunnel: start | status | url | stop | doctor | install | domain
#   web                   Open the MSO browser UI (active gateway first, else loopback)
#
#  Browser
#   camoufox *           Power the anti-detection VNC browser + read its password
#
#  Apps
#   apps                 App-store runtime apps
#   mapp *               Managed apps on the box (hermes, openclaw): logs, update…
#   term *               Interactive PTY sessions (open | input | resize | stream | close)
#
#  AI + state
#   ai <prompt…>         One turn with the assistant
#   cockpit [project]    Alfa/MSO runtime context; search with `cockpit search <query>`
#   threads *            Conversation history: list | show | rm
#   agent-sessions *     Durable MSO Agent sessions: list | show | create
#   agents *             Native local session agents: list | send | inbox
#   a2a *                Agent-to-Agent v1: list | discover | add | rm | send | task | cancel | handoff
#   memory *             Assistant memories: list | add | rm
#   config *             Advanced raw AI config compatibility surface
#   prefs *              UI preferences: show | set
#   models *             Configure AI providers/auth; inspect model catalog
#   skills *             Discover host skills + curated market: available/install/remove
#   changelog            What shipped, newest first (same text Settings → About shows)
#   mcp *                MCP tokens + live activity: list | activity [n] | revoke <id> | revoke all
#   oauth <prov> *       Provider sign-in (device code): start | poll
#   audit [n] [prefix]   Audit trail, newest first (writes/exec/auth; reads are not logged)
#   stock <query> [page] Stock-image search (Unsplash key optional, Openverse fallback)
#
#  Devices  (a local file — these work while the service is down)
#   device *             list | pending | approve [--role] | role | revoke | revoke all --yes
#   devices              Alias for `device list`
#   approve <id> [label] [--role ...]  Approve a device id
#   revoke <id>          Revoke one device
#   whoami               This CLI's device id + session state
#   login                Force a fresh login
#   logout               Drop the session (server-side + local jar)
#
#  Service  (local systemd)
#   service *            status | start | stop | restart | logs
#   build                Compile HEAD out-of-tree (safe against the live checkout)
#   deploy               Rebuild active service with runtime quiesce/restore
#   update [--rebuild]   Update from origin/main safely; works even when the web runtime is down
#
#   reset [--scope config|all]  Preview local factory reset; explicit token required to apply
#   uninstall [--purge] [--remove-code]  Preview owned installation removal
#
#  Escape hatches
#   crud *               Generic resource CRUD, incl. editor documents
#   api *                Call ANY endpoint directly
#   completion [shell]   Print a shell completion script (bash|zsh)
#   version              Show version
#
# Examples:
#   mso doctor
#     First thing to run when something is off — it names the broken layer.
#   mso device pending
#     See who typed the correct password and is waiting to be let in.
#   mso device approve <id> "my phone" --role viewer
#     Let that device sign in with least-privilege read access.
#   mso exec "systemctl status nginx"
#     Run anything on the host, as the user that owns the process.
#   mso camoufox start && mso camoufox session
#     Bring the browser up and print its one-time VNC password.
#   mso raw ~/shot.png > ./shot.png
#     Pull a binary file down; `cat` is for text.
#   mso mapp logs hermes
#     Tail a managed app's log without opening the UI.
#   mso api POST /api/v1/sys/cleanup
#     No named verb for it? Call the endpoint directly.
#
# Environment:
#   MSO_BASE             Same as --base
#   MSO_ENV              Same as --env
#   MSO_PASSWORD         Overrides OS_LOGIN_PASSWORD from the env file
#   MSO_DEVICE           Overrides this CLI's device id (~/.mso/cli.device.id)
#   MSO_GATEWAY_LOCAL_URL Loopback upstream for gateway/web (default http://127.0.0.1:4005)
#
# READ = OS_FS_READ_ROOTS; WRITE = home + ~/projects; exec = full host power.
#
# Docs: https://github.com/rahmanef63/mso
set -euo pipefail

VERSION="1.13.0"
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

die() { echo "mso: $*" >&2; exit 1; }

# Global options are parsed BEFORE the env file is sourced, because --env chooses
# which file that is.
BASE_OVERRIDE=""; ENV_OVERRIDE=""; AGENT_START_ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --base) [ -n "${2-}" ] || die "--base needs a url"; BASE_OVERRIDE="$2"; shift 2 ;;
    --env)  [ -n "${2-}" ] || die "--env needs a file";  ENV_OVERRIDE="$2";  shift 2 ;;
    --continue|-c) AGENT_START_ARGS+=("--continue"); shift ;;
    --resume|-r) [ -n "${2-}" ] || die "$1 needs a session query"; AGENT_START_ARGS+=("--resume" "$2"); shift 2 ;;
    --yolo|-yolo) AGENT_START_ARGS+=("--yolo"); shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

# Dispatch local maintenance before sourcing credentials or creating a cookie jar.
case "${1-}" in
  reset|uninstall)
    [ -z "$BASE_OVERRIDE$ENV_OVERRIDE${MSO_BASE:-}${OS_BASE:-}${MSO_ENV:-}${OS_ENV:-}" ] \
      || die "maintenance is local-only; omit --base/--env and run over SSH on the intended host"
    exec node "$ROOT/scripts/mso-maintenance.mjs" "$@" ;;
esac

B="${BASE_OVERRIDE:-${MSO_BASE:-${OS_BASE:-http://127.0.0.1:4005}}}"
ENVF="${ENV_OVERRIDE:-${MSO_ENV:-${OS_ENV:-$ROOT/.env.local}}}"
# shellcheck disable=SC1090
set -a; . "$ENVF" 2>/dev/null || true; set +a

need() { command -v "$1" >/dev/null || die "missing dependency: $1"; }
need curl; need jq; need realpath; need stat; need mktemp; need sha256sum

# Resolve the LOCAL upstream for gateway/web without ever widening the app bind.
# Priority: explicit override → a loopback --base/MSO_BASE → the installed service's
# PORT → MSO_PORT → 4005. This keeps non-default installer ports working on Linux
# while WSL/no-systemd users still have an explicit override for manually-started
# runtimes.
# Runtime helpers are split by responsibility; bin/mso remains the entrypoint/dispatcher.
# shellcheck source=../scripts/cli/runtime.sh
source "$ROOT/scripts/cli/runtime.sh"

# Terminal agent + infrastructure-provider CLI slice. Sourced only after the
# generic HTTP/auth/onboarding helpers above exist, so it reuses those SSOT seams.
# shellcheck source=../scripts/mso-cli-agent.sh
source "$ROOT/scripts/mso-cli-agent.sh"


# shellcheck source=../scripts/cli/commands.sh
source "$ROOT/scripts/cli/commands.sh"
mso_cli_main "$@"
